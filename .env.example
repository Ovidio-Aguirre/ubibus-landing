# --- Cliente (se incluyen en el bundle público, deben empezar con VITE_) ---

# Clave PÚBLICA de reCAPTCHA v3 (la "Site key" de https://www.google.com/recaptcha/admin).
# Nunca pongas aquí la clave secreta.
VITE_RECAPTCHA_SITE_KEY=

# --- Servidor (solo usadas por las funciones serverless en /api, nunca llegan al navegador) ---

# Clave SECRETA de reCAPTCHA v3 ("Secret key"). Se usa para verificar tokens server-side.
RECAPTCHA_SECRET_KEY=

# Cuenta de servicio de Firebase (Admin SDK), para escribir en Firestore sin pasar
# por las Security Rules. Generarla en Firebase Console > Configuración del proyecto
# > Cuentas de servicio > Generar nueva clave privada.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
